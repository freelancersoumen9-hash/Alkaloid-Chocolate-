<!DOCTYPE html>
<html lang="bn" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akalioid Unani Laboratories | Artisanal Herbal Choco</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        choco: {
                            950: '#140b07',
                            900: '#23120b',
                            800: '#381c11',
                            700: '#4e2818',
                            600: '#6d3922',
                        },
                        gold: {
                            300: '#fde047',
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                            700: '#a16207',
                        },
                        cream: {
                            100: '#fefce8',
                            200: '#fef9c3',
                            300: '#fef08a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Hind Siliguri', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Hind Siliguri', 'Inter', sans-serif;
            background-color: #140b07;
            color: #fefce8;
        }
        .gold-border {
            border: 1px solid rgba(234, 179, 8, 0.25);
        }
        .glass-choco {
            background: rgba(35, 18, 11, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(234, 179, 8, 0.2);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fef08a 0%, #eab308 50%, #ca8a04 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(20, 11, 7, 0.9);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #a16207;
            border-radius: 4px;
        }
    </style>
</head>
<body class="custom-scrollbar min-h-screen flex flex-col justify-between selection:bg-gold-500 selection:text-choco-950">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 w-full glass-choco border-b border-gold-500/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            
            <!-- Brand Logo & Personal Title -->
            <a href="#home" class="flex items-center space-x-3 group shrink-0">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-choco-700 via-gold-600 to-gold-400 flex items-center justify-center text-choco-950 text-2xl font-black shadow-lg shadow-gold-500/10 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-cookie-bite"></i>
                </div>
                <div>
                    <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white block font-serif">Akalioid</span>
                    <span class="text-[10px] sm:text-xs font-bold tracking-widest text-gold-400 uppercase -mt-1 block">Unani Laboratories</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden lg:flex items-center space-x-6 text-sm font-semibold">
                <a href="#home" class="hover:text-gold-400 transition-colors lang-bn">হোম</a>
                <a href="#home" class="hover:text-gold-400 transition-colors lang-en hidden">Home</a>

                <a href="#products" class="hover:text-gold-400 transition-colors lang-bn">চকলেট কালেকশন</a>
                <a href="#products" class="hover:text-gold-400 transition-colors lang-en hidden">Chocolates</a>

                <a href="#about" class="hover:text-gold-400 transition-colors lang-bn">আমাদের গল্প</a>
                <a href="#about" class="hover:text-gold-400 transition-colors lang-en hidden">Our Story</a>

                <a href="#contact" class="hover:text-gold-400 transition-colors lang-bn">যোগাযোগ</a>
                <a href="#contact" class="hover:text-gold-400 transition-colors lang-en hidden">Contact</a>
            </nav>

            <!-- Actions & Language Switcher -->
            <div class="flex items-center gap-3">
                <!-- Language Toggle Button -->
                <button onclick="toggleLanguage()" class="px-3 py-1.5 rounded-lg border border-gold-500/40 text-gold-400 hover:bg-gold-500/10 text-xs font-bold transition-all">
                    <span id="langLabel">English</span>
                </button>

                <!-- Admin Add Chocolate Button -->
                <button onclick="openAddProductModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-gold-500 to-amber-600 hover:from-gold-400 hover:to-amber-500 text-choco-950 font-bold text-xs sm:text-sm shadow-lg shadow-gold-500/20 flex items-center gap-2 transition-all transform hover:-translate-y-0.5">
