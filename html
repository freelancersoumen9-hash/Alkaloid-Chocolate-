                    <span class="hidden sm:inline lang-bn">নতুন চকলেট যুক্ত করুন</span>
                    <span class="hidden sm:inline lang-en hidden">Add Chocolate</span>
                </button>

                <!-- Mobile Menu Toggle -->
                <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-xl bg-choco-800/80 border border-gold-500/30 text-gold-400">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Nav Menu -->
        <div id="mobileMenu" class="hidden lg:hidden px-6 pt-2 pb-6 space-y-3 bg-choco-950 border-b border-gold-500/20">
            <a href="#home" class="block py-2 text-sm hover:text-gold-400 font-medium">হোম (Home)</a>
            <a href="#products" class="block py-2 text-sm hover:text-gold-400 font-medium">চকলেট কালেকশন (Collection)</a>
            <a href="#about" class="block py-2 text-sm hover:text-gold-400 font-medium">আমাদের গল্প (About)</a>
            <a href="#contact" class="block py-2 text-sm hover:text-gold-400 font-medium">যোগাযোগ (Contact)</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="relative pt-12 pb-16 lg:pt-24 lg:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/10 text-gold-400 text-xs sm:text-sm font-semibold">
                    <i class="fa-solid fa-gem"></i>
                    <span class="lang-bn">ভবিষ্যত প্রিমিয়াম ভেষজ চকলেট উদ্যোগ</span>
                    <span class="lang-en hidden">Future Herbal Artisanal Chocolate House</span>
                </div>
                
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight font-serif">
                    <span class="lang-bn">আকালীয়ড ল্যাবরেটরিজ</span>
                    <span class="lang-en hidden">Akalioid Laboratories</span> <br>
                    <span class="gold-gradient-text">আর্টিসানাল উইনানীয় চকোলেট</span>
                </h1>
                
                <p class="text-gray-300 text-base sm:text-lg max-w-xl leading-relaxed">
                    <strong>Akalioid Unani Laboratories</strong> তৈরি করছে অর্গানিক ইউনানী ভেষজ উপাদান ও খাঁটি কোকো দিয়ে তৈরি স্বাস্থ্যের জন্য উপকারী ডার্ক চকলেট। ঐতিহ্যবাহী ইউনানী চিকিৎসা বিজ্ঞানের ছোঁয়ায় তৈরি রাজকীয় চকলেট অভিজ্ঞতা।
                </p>

                <div class="flex flex-wrap gap-4 pt-2">
                    <a href="#products" class="px-7 py-3.5 rounded-xl bg-gold-500 hover:bg-gold-400 text-choco-950 font-extrabold shadow-lg shadow-gold-500/20 transition-all flex items-center gap-2">
                        <span class="lang-bn">চকলেট ক্যাটালগ দেখুন</span>
                        <span class="lang-en hidden">Browse Chocolates</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <button onclick="openAddProductModal()" class="px-7 py-3.5 rounded-xl glass-choco hover:bg-choco-800/60 text-gold-300 font-semibold border border-gold-500/30 transition-all">
                        <span class="lang-bn">+ নতুন পিকচার যুক্ত করুন</span>
                        <span class="lang-en hidden">+ Add Unlimited Pictures</span>
                    </button>
                </div>
            </div>

            <!-- Hero Feature Card -->
            <div class="relative">
                <div class="absolute inset-0 bg-gradient-to-tr from-gold-600/20 to-choco-700/30 rounded-3xl blur-3xl -z-10"></div>
                <div class="p-4 sm:p-6 rounded-3xl glass-choco border border-gold-500/30 relative">
                    <img src="https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=800&q=80" alt="Artisanal Dark Chocolate" class="w-full h-[350px] sm:h-[420px] object-cover rounded-2xl shadow-2xl">
                    <div class="absolute bottom-8 left-8 right-8 glass-choco p-4 rounded-xl border border-gold-500/40 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-lg bg-gold-500/20 text-gold-400 flex items-center justify-center text-2xl shrink-0">
                            <i class="fa-solid fa-crown"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-white font-serif">100% Pure Organic Cocoa</h4>
                            <p class="text-xs text-gray-300">আকালীয়ড ইউনানী ফর্মুলা সমৃদ্ধ হেলদি চকলেট</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Showcase Section -->
    <section id="products" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
            <div>
                <span class="text-gold-400 font-bold text-xs uppercase tracking-widest">Future Company Collection</span>
                <h2 class="text-3xl sm:text-4xl font-black font-serif mt-1">চকলেট গ্যালারি ও ক্যাটালগ</h2>
            </div>

            <!-- Search & Filter Controls -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <div class="relative w-full sm:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="searchInput" oninput="filterProducts()" placeholder="চকলেট সার্চ করুন..." class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-gold-500">
                </div>
                <select id="categoryFilter" onchange="filterProducts()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-sm text-white focus:outline-none focus:border-gold-500">
                    <option value="all">সব ক্যাটাগরি</option>
                    <option value="Unani Dark">Unani Dark Chocolate</option>
                    <option value="Herbal Infused">Herbal Infused</option>
                    <option value="Premium Gift Box">Premium Gift Box</option>
                    <option value="Sugar Free">Sugar Free Health Choco</option>
                </select>
            </div>
        </div>

        <!-- Products Grid Container -->
        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Dynamic chocolate cards will render here -->
        </div>

        <!-- Empty State -->
        <div id="noProductsMsg" class="hidden text-center py-16 glass-choco rounded-2xl">
            <i class="fa-solid fa-box-open text-5xl text-gold-500/40 mb-3 block"></i>
            <h3 class="text-xl font-bold text-gray-300">কোন চকলেট পাওয়া যায়নি!</h3>
            <p class="text-sm text-gray-400 mt-1">উপরে 'নতুন চকলেট যুক্ত করুন' বাটনে ক্লিক করে ছবি ও বিবরণ যোগ করুন।</p>
        </div>
    </section>

    <!-- Story / About Section -->
    <section id="about" class="py-16 bg-choco-900/60 border-y border-gold-500/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="space-y-4">
                    <span class="text-gold-400 font-bold text-xs uppercase tracking-widest">Personal Vision</span>
                    <h2 class="text-3xl sm:text-4xl font-black font-serif">আকালীয়ড ইউনানী ল্যাবরেটরিজ সম্পর্কে</h2>
                    <p class="text-gray-300 leading-relaxed text-sm sm:text-base">
                        <strong>Akalioid Unani Laboratories</strong> কেবল একটি নাম নয়, এটি ভবিষ্যত প্রিমিয়াম চকলেট উদ্যোগের একটি স্বপ্ন। বিজ্ঞানের সাথে ইউনানী ভেষজের মেলবন্ধন ঘটিয়ে আমরা তৈরি করতে চলেছি স্বাস্থ্যকর ডার্ক চকলেট, যা স্বাদ ও পুষ্টির অনন্য দৃষ্টান্ত গড়ে তুলবে।
                    </p>
                    <div class="grid grid-cols-2 gap-4 pt-4">
                        <div class="p-4 rounded-xl glass-choco">
                            <h4 class="font-bold text-gold-400 text-lg">১০০% ভেষজ</h4>
                            <p class="text-xs text-gray-400">অর্গানিক কোকো ও ভেষজ নির্যাস</p>
                        </div>
                        <div class="p-4 rounded-xl glass-choco">
                            <h4 class="font-bold text-gold-400 text-lg">অপার পিকচার অপশন</h4>
                            <p class="text-xs text-gray-400">প্রতিটি আইটেমে আনলিমিটেড ইমেজ</p>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=800&q=80" alt="Chocolates" class="rounded-2xl border border-gold-500/30 shadow-2xl">
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Order Section -->
    <section id="contact" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="p-8 rounded-3xl glass-choco border border-gold-500/30 text-center max-w-3xl mx-auto space-y-6">
            <div class="w-16 h-16 rounded-2xl bg-gold-500/20 text-gold-400 flex items-center justify-center text-3xl mx-auto">
                <i class="fa-solid fa-envelope-open-text"></i>
            </div>
            <h2 class="text-3xl font-black font-serif">যোগাযোগ ও ইনকোয়ারি</h2>
            <p class="text-sm text-gray-300">
                Akalioid Unani Laboratories ভবিষ্যৎ চকলেট উদ্যোগ সম্পর্কিত প্রশ্নের জন্য আমাদের ইমেইল বা কল করুন।
            </p>
            <div class="flex flex-wrap justify-center gap-6 text-sm font-bold text-gold-400">
                <div><i class="fa-solid fa-envelope mr-2"></i> info@akalioidunanilab.com</div>
                <div><i class="fa-solid fa-phone mr-2"></i> +880 1700-000000</div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 bg-choco-950 border-t border-gold-500/20 text-center text-xs text-gray-400">
        <p class="font-bold text-gold-400">Akalioid Unani Laboratories © 2026</p>
        <p class="mt-1">Future Artisanal Herbal Chocolate Company. All Rights Reserved.</p>
    </footer>


    <!-- ================= MODALS SECTION ================= -->

    <!-- Add/Edit Chocolate Modal (Unlimited Pictures Option) -->
    <div id="productModal" class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto custom-scrollbar">
        <div class="bg-choco-950 border border-gold-500/40 w-full max-w-2xl rounded-3xl p-6 sm:p-8 shadow-2xl relative my-8">
            <button onclick="closeAddProductModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 id="modalFormTitle" class="text-2xl font-black text-white font-serif mb-1">নতুন চকলেট যুক্ত করুন</h3>
            <p class="text-xs text-gold-400/80 mb-6">Akalioid Unani Laboratories ক্যাটালগে আনলিমিটেড পিকচার সহ নতুন চকলেট যুক্ত করুন।</p>

            <form id="productForm" onsubmit="saveProduct(event)" class="space-y-4 text-sm">
                <input type="hidden" id="editProductId">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold mb-1 text-gray-300">চকলেটের নাম (Title) *</label>
                        <input type="text" id="pTitle" required placeholder="e.g. Akalioid Royal Unani Dark Bar" class="w-full px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-white focus:outline-none focus:border-gold-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1 text-gray-300">ক্যাটাগরি *</label>
                        <select id="pCategory" required class="w-full px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-white focus:outline-none focus:border-gold-500">
                            <option value="Unani Dark">Unani Dark Chocolate</option>
                            <option value="Herbal Infused">Herbal Infused</option>
                            <option value="Premium Gift Box">Premium Gift Box</option>
                            <option value="Sugar Free">Sugar Free Health Choco</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold mb-1 text-gray-300">মূল্য (Price in BDT/Tk) *</label>
                        <input type="number" id="pPrice" required placeholder="e.g. 450" class="w-full px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-white focus:outline-none focus:border-gold-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1 text-gray-300">সংক্ষিপ্ত বৈশিষ্ট্য / উপাদান</label>
                        <input type="text" id="pBenefits" placeholder="e.g. 75% Dark Cocoa, Ashwagandha & Honey" class="w-full px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-white focus:outline-none focus:border-gold-500">
                    </div>
                </div>

                <!-- UNLIMITED PICTURES INPUT -->
                <div class="p-4 rounded-2xl bg-choco-900 border border-gold-500/30 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold text-gold-400">
                            <i class="fa-solid fa-images mr-1"></i> চকলেটের ছবিসমূহ (Unlimited Images)
                        </label>
                        <span class="text-[10px] text-gray-400">একাধিক ছবি সাপোর্ট করে</span>
                    </div>

                    <!-- Multi-File Upload -->
                    <div>
                        <label class="block text-[11px] text-gray-300 mb-1">পিসি/মোবাইল থেকে ছবি পছন্দ করুন:</label>
                        <input type="file" id="pImageFiles" multiple accept="image/*" onchange="handleFileUpload(event)" class="block w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-gold-600 file:text-choco-950 hover:file:bg-gold-500 cursor-pointer">
                    </div>

                    <!-- Image URLs (Comma-separated) -->
                    <div>
                        <label class="block text-[11px] text-gray-300 mb-1">অথবা ছবিগুলির URL লিংক দিন (কমা দিয়ে একাধিক):</label>
                        <textarea id="pImageUrls" rows="2" placeholder="https://image1.jpg, https://image2.jpg" class="w-full px-3 py-2 rounded-xl bg-choco-950 border border-gold-500/30 text-xs text-white focus:outline-none focus:border-gold-500"></textarea>
                    </div>

                    <!-- Thumbnails Preview Container -->
                    <div id="imagePreviewContainer" class="flex flex-wrap gap-2 pt-1"></div>
                </div>

                <div>
                    <label class="block text-xs font-semibold mb-1 text-gray-300">বিস্তারিত বিবরণ (Description) *</label>
                    <textarea id="pDescription" rows="3" required placeholder="চকলেটের বিশেষত্ব, স্বাদ এবং ইউনানী উপাদানের তথ্য লিখুন..." class="w-full px-4 py-2.5 rounded-xl bg-choco-900 border border-gold-500/30 text-white focus:outline-none focus:border-gold-500"></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-3">
                    <button type="button" onclick="closeAddProductModal()" class="px-5 py-2.5 rounded-xl border border-gray-700 text-gray-300 hover:bg-choco-900">বাতিল</button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-400 text-choco-950 font-extrabold shadow-lg">সংরক্ষণ করুন</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Product Details & Unlimited Gallery Modal -->
    <div id="detailsModal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto custom-scrollbar">
        <div class="bg-choco-950 border border-gold-500/40 w-full max-w-3xl rounded-3xl p-6 sm:p-8 shadow-2xl relative my-8">
            <button onclick="closeDetailsModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white text-xl z-10">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Gallery Carousel View -->
                <div>
                    <div class="relative rounded-2xl overflow-hidden border border-gold-500/30 bg-choco-900 aspect-square flex items-center justify-center">
                        <img id="mainDetailImage" src="" alt="Chocolate image" class="w-full h-full object-cover">
                        
                        <!-- Nav Controls for Unlimited Images -->
                        <button onclick="prevGalleryImage()" class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/70 text-gold-400 flex items-center justify-center hover:bg-gold-500 hover:text-choco-950 transition-colors">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button onclick="nextGalleryImage()" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/70 text-gold-400 flex items-center justify-center hover:bg-gold-500 hover:text-choco-950 transition-colors">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>

                    <!-- Thumbnails List -->
                    <div id="thumbnailsContainer" class="flex gap-2 mt-3 overflow-x-auto pb-2 custom-scrollbar"></div>
                </div>

                <!-- Info Details -->
                <div class="flex flex-col justify-between space-y-4">
                    <div>
                        <span id="detailBadge" class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-400 border border-gold-500/40 text-xs font-bold uppercase">Unani Dark</span>
                        <h2 id="detailTitle" class="text-2xl font-black text-white font-serif mt-2 mb-1">চকলেট টাইটেল</h2>
                        <div class="text-2xl font-black text-gold-400 mb-3" id="detailPrice">৳ 000 BDT</div>
                        
                        <div class="p-3 rounded-xl bg-choco-900 border border-gold-500/20 mb-4 text-xs">
                            <span class="text-gold-400 block font-semibold">উপাদান / হাইলাইটস:</span>
                            <span id="detailBenefits" class="text-gray-200 font-medium">উপাদান বিবরণ...</span>
                        </div>

                        <div class="text-xs text-gray-300 leading-relaxed space-y-2">
                            <h4 class="font-bold text-white text-sm">বিস্তারিত বিবরণ:</h4>
                            <p id="detailDescription" class="whitespace-pre-line">বিবরণ...</p>
                        </div>
                    </div>

                    <!-- Direct Actions -->
                    <div class="pt-4 border-t border-gold-500/20 flex gap-3">
                        <button onclick="orderInquiry()" class="w-full py-3 rounded-xl bg-gold-500 hover:bg-gold-400 text-choco-950 font-bold text-xs flex items-center justify-center gap-2 shadow-lg">
                            <i class="fa-solid fa-cart-shopping"></i> ইনকোয়ারি / অর্ডার করুন
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- JavaScript App Logic -->
    <script>
        // Sample Pre-populated Artisanal Chocolates
        const defaultChocolates = [
            {
                id: '1',
                title: 'Akalioid Royal Unani Dark Bar',
                category: 'Unani Dark',
                price: 480,
                benefits: '80% Premium Cocoa + Zafran & Ashwagandha',
                description: 'আকালীয়ড ল্যাবরেটরিজের সিগনেচার ডার্ক চকলেট। প্রিমিয়াম কোকোর সাথে খাঁটি জাফরান ও অশ্বগন্ধার ভেষজ মিশ্রণে তৈরি যা মানসিক চাপ কমাতে ও শক্তি জোগাতে সহায়ক।',
                images: [
                    'https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=600&q=80',
                    'https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=600&q=80'
                ]
            },
            {
                id: '2',
                title: 'Herbal Honey & Kalonji Choco Bites',
                category: 'Herbal Infused',
                price: 650,
                benefits: 'Cold-pressed Kalonji Extract & Natural Honey',
                description: 'কালোজিরা নির্যাস ও প্রাকৃতিক সুন্দরবনের মধুর মিষ্টি ছোঁয়ায় প্রস্তুতকৃত হ্যান্ডক্রাফটেড চকলেট বাইটস। রোগ প্রতিরোধ ক্ষমতা বৃদ্ধির জন্য অনন্য।',
                images: [
                    'https://images.unsplash.com/photo-1549007994-cb92caebd54b?auto=format&fit=crop&w=600&q=80',
                    'https://images.unsplash.com/photo-1606312619070-d48b4c652a52?auto=format&fit=crop&w=600&q=80'
                ]
            },
            {
                id: '3',
                title: 'Akalioid Gold Reserve Gift Box',
                category: 'Premium Gift Box',
                price: 1500,
                benefits: 'Assorted 12 Herbal Chocolates in Royal Box',
                description: 'অভিজাত উপহারের জন্য আকালীয়ড ল্যাবরেটরিজের বিশেষ গোল্ড রেজাল্ট গিফট বক্স। ১২টি বিভিন্ন স্বাদের আর্টিসানাল চকলেটের রাজকীয় সংগ্রহ।',
                images: [
                    'https://images.unsplash.com/photo-1526081347589-7fa3cb41b4b2?auto=format&fit=crop&w=600&q=80',
                    'https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?auto=format&fit=crop&w=600&q=80'
                ]
            }
        ];

        let products = [];
        let currentUploadedImages = [];
        let activeGalleryImages = [];
        let currentGalleryIndex = 0;
        let isEnglish = false;

        function initApp() {
            const stored = localStorage.getItem('akalioid_chocolates');
            if (stored) {
                try {
                    products = JSON.parse(stored);
                } catch(e) {
                    products = defaultChocolates;
                }
            } else {
                products = defaultChocolates;
                saveToStorage();
            }
            renderProducts(products);
        }

        function saveToStorage() {
            localStorage.setItem('akalioid_chocolates', JSON.stringify(products));
        }

        function renderProducts(items) {
            const grid = document.getElementById('productsGrid');
            const noMsg = document.getElementById('noProductsMsg');

            grid.innerHTML = '';

            if (!items || items.length === 0) {
                noMsg.classList.remove('hidden');
                return;
            } else {
                noMsg.classList.add('hidden');
            }

            items.forEach(product => {
                const coverImage = (product.images && product.images.length > 0) 
                    ? product.images[0] 
                    : 'https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=600&q=80';

                const imgCount = product.images ? product.images.length : 0;

                const card = document.createElement('div');
                card.className = "group rounded-2xl overflow-hidden glass-choco border border-gold-500/30 hover:border-gold-500 transition-all duration-300 flex flex-col justify-between";
                
                card.innerHTML = `
                    <div>
                        <!-- Image Area -->
                        <div class="h-56 overflow-hidden relative bg-choco-950">
                            <img src="${coverImage}" alt="${product.title}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-choco-950/80 border border-gold-500/40 text-gold-400 text-[10px] font-bold uppercase">
                                ${product.category}
                            </span>
                            ${imgCount > 1 ? `
                                <span class="absolute bottom-3 right-3 px-2 py-0.5 rounded-md bg-black/80 text-gold-300 text-[10px] font-semibold flex items-center gap-1 border border-gold-500/30">
                                    <i class="fa-solid fa-images"></i> ${imgCount} Pictures
                                </span>
                            ` : ''}
                        </div>

                        <!-- Info Area -->
                        <div class="p-5">
                            <h3 class="font-bold text-lg text-white mb-1 font-serif group-hover:text-gold-400 transition-colors line-clamp-1">${product.title}</h3>
                            <div class="text-xs text-gold-400/90 mb-2 font-medium line-clamp-1"><i class="fa-solid fa-leaf mr-1"></i>${product.benefits || 'Unani Herbal Chocolate'}</div>
                            <p class="text-xs text-gray-300 line-clamp-2 mb-4 leading-relaxed">${product.description}</p>
                        </div>
                    </div>

                    <!-- Price & Action Footer -->
                    <div class="px-5 pb-5 pt-3 border-t border-gold-500/20 flex items-center justify-between gap-2">
                        <div>
                            <span class="text-[10px] text-gray-400 block">মূল্য / Price:</span>
                            <span class="text-xl font-black text-gold-400">৳ ${product.price} <span class="text-xs font-normal">BDT</span></span>
                        </div>
                        
                        <div class="flex items-center gap-1.5">
                            <button onclick="openDetailsModal('${product.id}')" class="p-2.5 rounded-xl bg-gold-500/20 hover:bg-gold-500 hover:text-choco-950 text-gold-400 text-xs font-semibold transition-colors" title="গ্যালারি ও বিবরণ">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button onclick="openEditProductModal('${product.id}')" class="p-2.5 rounded-xl bg-amber-600/20 hover:bg-amber-600 text-amber-300 hover:text-white text-xs" title="এডিট">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="deleteProduct('${product.id}')" class="p-2.5 rounded-xl bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white text-xs" title="মুছে ফেলুন">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const category = document.getElementById('categoryFilter').value;

            const filtered = products.filter(p => {
                const matchesQuery = p.title.toLowerCase().includes(query) || 
                                     p.description.toLowerCase().includes(query) ||
                                     (p.benefits && p.benefits.toLowerCase().includes(query));
                const matchesCategory = category === 'all' || p.category === category;
                return matchesQuery && matchesCategory;
            });

            renderProducts(filtered);
        }

        // Unlimited File Upload Reader
        function handleFileUpload(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentUploadedImages.push(e.target.result);
                    renderImagePreviews();
                };
                reader.readAsDataURL(file);
            });
        }

        function renderImagePreviews() {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';

            currentUploadedImages.forEach((imgSrc, index) => {
                const thumb = document.createElement('div');
                thumb.className = "relative w-14 h-14 rounded-lg overflow-hidden border border-gold-500 group shrink-0";
                thumb.innerHTML = `
                    <img src="${imgSrc}" class="w-full h-full object-cover">
                    <button type="button" onclick="removeUploadedImage(${index})" class="absolute inset-0 bg-red-900/80 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-xs">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
                container.appendChild(thumb);
            });
        }

        function removeUploadedImage(index) {
            currentUploadedImages.splice(index, 1);
            renderImagePreviews();
        }

        function openAddProductModal() {
            document.getElementById('modalFormTitle').textContent = 'নতুন চকলেট যুক্ত করুন';
            document.getElementById('editProductId').value = '';
            document.getElementById('productForm').reset();
            currentUploadedImages = [];
            renderImagePreviews();
            document.getElementById('productModal').classList.remove('hidden');
        }

        function openEditProductModal(id) {
            const item = products.find(p => p.id === id);
            if (!item) return;

            document.getElementById('modalFormTitle').textContent = 'চকলেটের বিবরণ পরিবর্তন করুন';
            document.getElementById('editProductId').value = item.id;
            document.getElementById('pTitle').value = item.title;
            document.getElementById('pCategory').value = item.category;
            document.getElementById('pPrice').value = item.price;
            document.getElementById('pBenefits').value = item.benefits || '';
            document.getElementById('pDescription').value = item.description;

            currentUploadedImages = item.images ? [...item.images] : [];
            renderImagePreviews();

            document.getElementById('productModal').classList.remove('hidden');
        }

        function closeAddProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        function saveProduct(event) {
            event.preventDefault();

            const editId = document.getElementById('editProductId').value;
            const title = document.getElementById('pTitle').value;
            const category = document.getElementById('pCategory').value;
            const price = parseFloat(document.getElementById('pPrice').value);
            const benefits = document.getElementById('pBenefits').value;
            const description = document.getElementById('pDescription').value;

            const rawUrls = document.getElementById('pImageUrls').value;
            let urlList = rawUrls ? rawUrls.split(',').map(u => u.trim()).filter(u => u.length > 0) : [];
            
            let finalImages = [...currentUploadedImages, ...urlList];

            if (finalImages.length === 0) {
                finalImages.push('https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=600&q=80');
            }

            if (editId) {
                const index = products.findIndex(p => p.id === editId);
                if (index !== -1) {
                    products[index] = { id: editId, title, category, price, benefits, description, images: finalImages };
                }
            } else {
                const newChoco = {
                    id: Date.now().toString(),
                    title, category, price, benefits, description, images: finalImages
                };
                products.unshift(newChoco);
            }

            saveToStorage();
            renderProducts(products);
            closeAddProductModal();
        }

        function deleteProduct(id) {
            if (confirm('আপনি কি নিশ্চিত যে এই চকলেট আইটেমটি মুছে ফেলতে চান?')) {
                products = products.filter(p => p.id !== id);
                saveToStorage();
                renderProducts(products);
            }
        }

        // Gallery Details Modal
        function openDetailsModal(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            activeGalleryImages = (product.images && product.images.length > 0) 
                ? product.images 
                : ['https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=600&q=80'];
            
            currentGalleryIndex = 0;

            document.getElementById('detailTitle').textContent = product.title;
            document.getElementById('detailBadge').textContent = product.category;
            document.getElementById('detailPrice').textContent = `৳ ${product.price} BDT`;
            document.getElementById('detailBenefits').textContent = product.benefits || 'Unani Herbal Formulation';
            document.getElementById('detailDescription').textContent = product.description;

            updateGalleryView();
            document.getElementById('detailsModal').classList.remove('hidden');
        }

        function updateGalleryView() {
            document.getElementById('mainDetailImage').src = activeGalleryImages[currentGalleryIndex];

            const thumbsContainer = document.getElementById('thumbnailsContainer');
            thumbsContainer.innerHTML = '';

            activeGalleryImages.forEach((img, i) => {
                const thumb = document.createElement('img');
                thumb.src = img;
                thumb.className = `w-14 h-14 rounded-xl object-cover cursor-pointer border-2 ${i === currentGalleryIndex ? 'border-gold-500 scale-105' : 'border-transparent opacity-50'} transition-all shrink-0`;
                thumb.onclick = () => {
                    currentGalleryIndex = i;
                    updateGalleryView();
                };
                thumbsContainer.appendChild(thumb);
            });
        }

        function prevGalleryImage() {
            currentGalleryIndex = (currentGalleryIndex - 1 + activeGalleryImages.length) % activeGalleryImages.length;
            updateGalleryView();
        }

        function nextGalleryImage() {
            currentGalleryIndex = (currentGalleryIndex + 1) % activeGalleryImages.length;
            updateGalleryView();
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').classList.add('hidden');
        }

        function orderInquiry() {
            alert('Akalioid Unani Laboratories: আপনার পছন্দটি নথিবদ্ধ হয়েছে! ভবিষ্যৎ অর্ডারের জন্য যোগাযোগ করুন।');
        }

        // Language Switcher
        function toggleLanguage() {
            isEnglish = !isEnglish;
            document.getElementById('langLabel').textContent = isEnglish ? 'বাংলা' : 'English';

            document.querySelectorAll('.lang-bn').forEach(el => el.classList.toggle('hidden', isEnglish));
            document.querySelectorAll('.lang-en').forEach(el => el.classList.toggle('hidden', !isEnglish));
        }

        document.getElementById('mobileMenuBtn').addEventListener('click', () => {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        });

        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>